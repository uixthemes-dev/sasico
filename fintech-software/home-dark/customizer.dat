	--sasi-font-main: DM Sans, sans-serif;
	--sasi-font-second: DM Sans, sans-serif;
	--sasi-body-line-height: 24px;
	--sasi-bg-color-input: transparent;
}
.grid-box .entry-media{
	margin-bottom: 20px;
}
.grid-box .meta-grid{
	margin-bottom: 10px;
}
.grid-box .entry-title{
	font-size: 20px;
	line-height: 30px;
}
.grid-box .excerpt-post{
	margin-top: 15px;
}
.gstyle2 .meta-grid .posted-in a{
	color: #000;
}
.page-header .post-title{
	font-size: 48px;
	font-weight: 600;
}
.page-header .entry-meta{
	background: #ffffffA6;
}
.blog-post blockquote::before{
	line-height: 180px;
}
.widget .recent-news h4{
	font-weight: 500;
}

.second-form+.wpcf7-response-output{
	position: absolute;
	width: 100%;
	background: #000;
}
.wpcf7-form input, .wpcf7-form textarea, .wpcf7-form select{
	border-radius: 10px;
}
.sasi-cf-form .wpcf7-form-control-wrap input, .sasi-cf-form .wpcf7-form-control-wrap textarea, .sasi-cf-form .wpcf7-form-control-wrap select{
	padding: 15px 20px;
}
.second-form input, .second-form textarea, .second-form select{
	background-color: transparent!important;
}
.btn-readmore .sasi-btn{
	padding: 11px 23px!important;
}
.form-submit .sasi-btn{
	padding: 15px 25px
}
.btn-readmore .sasi-btn .sasi-icon,
.form-submit .sasi-btn .sasi-icon{
	display: none;
}
.sasi-ratings::after, .sasi-ratings::before{
	color: var(--sasi-color-primary);
}
.sasi-carousel .sasi-dots-classic .owl-dot{ padding: 0 3px; }
.sasi-carousel .sasi-dots-classic .owl-dot.active span{
	transform: none;
}";}